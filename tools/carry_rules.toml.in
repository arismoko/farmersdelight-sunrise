# (Named *.toml.in: the Horizon packager refuses .toml files outside src/.)
# Rules for tools/carry_fd.py (PORT_PLAN D6, M0-05). Change these and re-run; never hand-edit carried files.

[source]
repo = "https://github.com/MehVahdJukaar/FarmersDelightRefabricated"
sha = "1b85d66f5e2aba88592d7f4fb203d582f4d3cbe3"
# Order matters only for reporting: an overlapping path between roots is a hard error.
roots = ["src/generated/resources", "src/main/resources"]

# A file is carried only if its path (relative to a root) starts with one of these.
include_prefixes = [
  "assets/farmersdelight/",
  "data/farmersdelight/",
  "data/c/tags/",
  "data/minecraft/tags/",
]

# fnmatch patterns (matched against the relative path); exclusion wins over inclusion.
exclude = [
  "data/farmersdelight/recipe/integration/*",
  "data/farmersdelight/scripts/*",
  "data/farmersdelight/create/*",
  "data/farmersdelight/potato_cannon_projectile_types/*",
  "data/farmersdelight/weapon_attributes/*",
  "data/farmersdelight/horizon/*",          # owned by tools/gen_decls.py
  "assets/farmersdelight/rrv/*",
  "assets/farmersdelight/textures/gui/jei/*",
  "assets/farmersdelight/textures/gui/emi/*",
  "assets/farmersdelight/textures/gui/eiv/*",
  "*.classtweaker",
  "*.mixins.json",
  "fabric.mod.json",
  "*.java",
]

# Second source (BX-01): Fabric API's convention tags, which Fabric ships beside FD and Horizon does not. Every file
# under data/c/tags/ is carried; one FD also carries is merged (FD's entries, then Fabric's missing ones).
# Licence Apache-2.0: third_party/fabric-api/LICENSE, NOTICE.
[fapi]
repo = "https://github.com/FabricMC/fabric"
tag = "0.160.4+26.3"
sha = "542047fffa4f49d96d4863d2c7abf0b508554f70"
root = "fabric-convention-tags-v2/src/generated/resources"
include_prefixes = ["data/c/tags/"]

# Add-on tag overlays (BX-02): each file lists add-on ids for FD-namespace tags the base carries (format: carry_lib
# overlay_tags). Copied from the add-on repo's generated tools/overlay/<addon>.json; the sha256 pins the copy.
[[overlay]]
file = "tools/addon_overlays/moredelight.json"
sha256 = "3d639855211ba8de5ec35f837df9a8f9457133166c2837d7ff9f204ad4e90e70"

[[overlay]]
file = "tools/addon_overlays/corn_delight.json"
sha256 = "63df1e087afdff4a483f0f360ed4ffc0bcd7b65e078970ca76ad5160007c089c"

# Base-owned tags (MD-09, BX-03): generated with `values`, then add-on overlay entries are appended. Not FD data: FD
# answers these questions in code (`instanceof`), which an add-on's content-only items cannot join.
[[base_tag]]
tag = "ported_farmersdelight:knife_items"
kind = "item"
# `toolStack.getItem() instanceof KnifeItem`: FD's six knives (ModItems order) + add-on KnifeItems (DelightLib's
# KnifeBuilder builds `new KnifeItem`). Read by the Knife part (pumpkin carving, attached with item_part_tag) and
# knife knockback.
values = [
  "farmersdelight:flint_knife",
  "farmersdelight:copper_knife",
  "farmersdelight:iron_knife",
  "farmersdelight:diamond_knife",
  "farmersdelight:netherite_knife",
  "farmersdelight:golden_knife",
]

[[base_tag]]
tag = "ported_farmersdelight:effect_tooltip"
kind = "item"
# FD's food-effect tooltip opt-in (BX-03): the ConsumableItems built with hasFoodEffectTooltip (= EFFECT_TOOLTIPS in
# src/items/food_tooltips.rs, checked by tools/test_carry.py) + add-on overlay entries. FD's own items keep their
# FoodTooltip part; the tooltip code reads the tag for every other member (src/items/tooltips.rs `tagged`).
values = [
  "farmersdelight:apple_cider",
  "farmersdelight:tomato_sauce",
  "farmersdelight:melon_popsicle",
  "farmersdelight:glow_berry_custard",
  "farmersdelight:fruit_salad",
  "farmersdelight:mixed_salad",
  "farmersdelight:nether_salad",
  "farmersdelight:barbecue_stick",
  "farmersdelight:egg_sandwich",
  "farmersdelight:chicken_sandwich",
  "farmersdelight:hamburger",
  "farmersdelight:bacon_sandwich",
  "farmersdelight:mutton_wrap",
  "farmersdelight:dumplings",
  "farmersdelight:stuffed_potato",
  "farmersdelight:cabbage_rolls",
  "farmersdelight:salmon_roll",
  "farmersdelight:cod_roll",
  "farmersdelight:kelp_roll",
  "farmersdelight:kelp_roll_slice",
  "farmersdelight:cooked_rice",
  "farmersdelight:bone_broth",
  "farmersdelight:beef_stew",
  "farmersdelight:chicken_soup",
  "farmersdelight:vegetable_soup",
  "farmersdelight:fish_stew",
  "farmersdelight:fried_rice",
  "farmersdelight:pumpkin_soup",
  "farmersdelight:baked_cod_stew",
  "farmersdelight:noodle_soup",
  "farmersdelight:onion_soup",
  "farmersdelight:bacon_and_eggs",
  "farmersdelight:pasta_with_meatballs",
  "farmersdelight:pasta_with_mutton_chop",
  "farmersdelight:mushroom_rice",
  "farmersdelight:roasted_mutton_chops",
  "farmersdelight:vegetable_noodles",
  "farmersdelight:steak_and_potatoes",
  "farmersdelight:ratatouille",
  "farmersdelight:squid_ink_pasta",
  "farmersdelight:grilled_salmon",
  "farmersdelight:roast_chicken",
  "farmersdelight:stuffed_pumpkin",
  "farmersdelight:honey_glazed_ham",
  "farmersdelight:shepherds_pie",
  "farmersdelight:gleaming_salad",
]

# Only rewrite: fabric:load_conditions -> neoforge:conditions with a mod-registered condition.
# Any fabric:load_conditions value not listed here makes the script fail.
[[load_condition]]
fabric = [{ condition = "farmersdelight:vanilla_crates_enabled" }]
# The condition is registered under the mod id: Horizon requires a load condition's namespace to equal the
# registering mod's id (crates/horizon-mod-vocab/src/content/load_conditions.rs, LoadConditionDeclarations).
neoforge = [{ type = "ported_farmersdelight:vanilla_crates_enabled" }]

# Whole-file overrides (approved exceptions to D6's single rewrite, each with its reason). The file
# under tools/carry_overrides/<dest> replaces the carried one; the manifest records rule "override".
[[override]]
dest = "assets/farmersdelight/items/skillet.json"
# FD's `farmersdelight:skillet_flip` node is `{"model": id}` with an animated Java renderer. Horizon's
# mod item-model nodes list named child nodes under `models` and only choose among them
# (register_item_models / item_model_update; ids must be `<mod id>:<path>`), so the node is restated in
# that shape; the flip animation itself is omitted (delta A12, E-16).
reason = "item-model node shape differs (A12/E-16)"

# Scripted JSON rewrites (approved exceptions to D6's single rewrite, PORT_PLAN M6-02). Each applies to the
# carried files matching `glob`; the manifest records rule "rewrite". FD registers two worldgen codecs Horizon does
# not have; both have an exact vanilla 26.3 equivalent:
[[rewrite]]
glob = "data/farmersdelight/worldgen/feature/*.json"
# farmersdelight:in_order (InOrderFeature) places every listed placed feature and succeeds if any did, which is
# vanilla's minecraft:overlay (same `features` field).
rename_type = { from = "farmersdelight:in_order", to = "minecraft:overlay" }
reason = "in_order == minecraft:overlay"

[[rewrite]]
glob = "data/minecraft/tags/villager_trade/**/*.json"
# FD lists its trades as optional tag entries ({"id": …, "required": false}). The engine's villager_trade tag reader
# keeps only plain string entries (horizon-client merchant.rs Trades::load, `e.as_str()`), so FD's trades were
# dropped (E-27). Every listed trade is shipped by this mod, so the optional flag never matters: written as plain ids.
flatten_tag_entries = true
reason = "E-27: villager_trade tags keep only string entries"

[[rewrite]]
glob = "data/farmersdelight/worldgen/placed_feature/*.json"
# farmersdelight:biome_tag (BiomeTagFilter) keeps a position whose biome is in the tag; every placed feature names
# #minecraft:is_overworld, and the biome modifiers add these features only to overworld biomes (each FD biome tag
# lists overworld biomes only), so the filter never rejects and is dropped. It draws no random numbers.
drop_placement = "farmersdelight:biome_tag"
reason = "biome_tag(#is_overworld) always passes"

[[override]]
dest = "data/farmersdelight/worldgen/feature/wild_rice.json"
# farmersdelight:wild_rice (WildRiceFeature): water at the origin, air above, the lower half survives →
# DoublePlantBlock.placeAt (lower half waterlogged from the water, upper half dry). Restated with vanilla types:
# minecraft:overlay of a simple_block of the lower half at the origin (simple_block checks canSurvive) and a
# simple_block of the upper half one block up (its canSurvive needs the lower half below, so it is placed only when
# the lower one was). One simple_block of the lower half is not enough: the engine's worldgen places both halves only
# for vanilla's double plants (E-24). The placed feature already filters water / air above / substrate below.
reason = "wild_rice feature == lower + upper simple_block (E-24)"
