# (Named *.toml.in: the Horizon packager refuses .toml files outside src/.)
# Item declarations (PORT_PLAN M0-06/M1-01). Template minecraft:stick (neutral class) with every
# component explicit, so no sword/tool-class behaviour is inherited. Generated by tools/gen_decls.py.

[flint_knife]
source = "J/common/registry/ModItems.java:FLINT_KNIFE,knifeItem; J/common/registry/ModToolMaterials.java:FLINT; J/common/item/KnifeItem.java:createAttributes"
template = "minecraft:stick"
max_stack_size = 1
[flint_knife.components]
"minecraft:max_damage" = 131
"minecraft:damage" = 0
"minecraft:enchantable" = { value = 5 }
"minecraft:repairable" = { items = "#farmersdelight:flint_tool_materials" }
"minecraft:attribute_modifiers" = [
  { type = "minecraft:attack_damage", id = "minecraft:base_attack_damage", amount = 1.5, operation = "add_value", slot = "mainhand" },
  { type = "minecraft:attack_speed", id = "minecraft:base_attack_speed", amount = -2.0, operation = "add_value", slot = "mainhand" },
]
"minecraft:tool" = { rules = [
  { blocks = "#minecraft:incorrect_for_wooden_tool", correct_for_drops = false },
  { blocks = "#farmersdelight:mineable/knife", speed = 4.0, correct_for_drops = true },
  { blocks = "#farmersdelight:knife_instantly_mines", speed = 3.4028234663852886e38 },
], default_mining_speed = 1.0, damage_per_block = 1, can_destroy_blocks_in_creative = false }
"minecraft:weapon" = { item_damage_per_attack = 1 }

[copper_knife]
