[minced_beef]
source = "J/common/registry/ModItems.java:MINCED_BEEF; J/common/FoodValues.java:MINCED_BEEF,ConsumableValues.FAST_FOOD"
template = "minecraft:stick"
[minced_beef.components]
"minecraft:food" = { nutrition = 2, saturation = 1.2 }  # saturation = nutrition * 0.3 * 2
"minecraft:consumable" = { consume_seconds = 0.8 }

[beef_patty]
source = "J/common/registry/ModItems.java:BEEF_PATTY; J/common/FoodValues.java:BEEF_PATTY,ConsumableValues.FAST_FOOD"
template = "minecraft:stick"
[beef_patty.components]
"minecraft:food" = { nutrition = 4, saturation = 6.4 }  # saturation = nutrition * 0.8 * 2
"minecraft:consumable" = { consume_seconds = 0.8 }

[skillet]
source = "J/common/registry/ModItems.java:SKILLET; J/common/item/SkilletItem.java:SKILLET_MATERIAL=IRON,createAttributes(5,-3.1),knockback +1"
# Plain item (no `block`): a normal right-click reaches `use` (held cooking); sneak-placing the
# skillet block is done in code (SkilletItem#place only places while sneaking).
template = "minecraft:stick"
max_stack_size = 1
[skillet.components]
"minecraft:max_damage" = 250
"minecraft:damage" = 0
"minecraft:enchantable" = { value = 14 }
"minecraft:repairable" = { items = "#minecraft:iron_tool_materials" }
"minecraft:attribute_modifiers" = [
  { type = "minecraft:attack_damage", id = "minecraft:base_attack_damage", amount = 7.0, operation = "add_value", slot = "mainhand" },
  { type = "minecraft:attack_speed", id = "minecraft:base_attack_speed", amount = -3.1, operation = "add_value", slot = "mainhand" },
  { type = "minecraft:attack_knockback", id = "farmersdelight:base_attack_knockback", amount = 1.0, operation = "add_value", slot = "mainhand" },
]
"minecraft:tool" = { rules = [], default_mining_speed = 1.0, damage_per_block = 1, can_destroy_blocks_in_creative = false }
"minecraft:weapon" = { item_damage_per_attack = 1 }

