# Template minecraft:hay_block: hay's properties, fall damage × 0.2 and fire odds (FD registers 60 ignite / 20 burn,
# hay's own). Declared 6-way `facing` (default up) set to the clicked face in code; the template's `axis` is unused
# by the model. Signal smoke under a campfire: #farmersdelight:campfire_signal_smoke (code).
template = "minecraft:hay_block"
state_properties = { facing = { type = "enum", values = ["up", "down", "north", "south", "west", "east"] } }
default_state = { facing = "up" }
[rice_bale.components]
"minecraft:compostable" = { layers = "minecraft:compostable/medium_high" }  # CompostableHelper 0.85

