[sandy_shrub]
source = "J/common/registry/ModBlocks.java:SANDY_SHRUB (ofFullCopy(TALL_GRASS)); J/common/block/SandyShrubBlock.java:SHAPE,mayPlaceOn(SAND)"
# On `#minecraft:sand` only, no bone meal (isValidBonemealTarget is false). Template minecraft:short_dry_grass:
# the worldgen survival check reads the template's rule (E-25), and short grass refuses sand. Grass sounds and
# plant map colour as TALL_GRASS.
template = "minecraft:short_dry_grass"
properties = { sounds = "minecraft:short_grass", map_color = 7 }
shapes = { default = [[0.125, 0.0, 0.125, 0.875, 0.8125, 0.875]] }
