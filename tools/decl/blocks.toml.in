# --- M7-06 canvas signs ---
# 17 boards (plain + 16 dyes) × 4 forms. FD: StandingCanvasSignBlock / WallCanvasSignBlock /
# CeilingHangingCanvasSignBlock / WallHangingCanvasSignBlock over WoodType.SPRUCE with ofFullCopy(SPRUCE_SIGN /
# SPRUCE_HANGING_SIGN) → spruce sign templates. `wood_type` farmersdelight:canvas[_<dye>] is the editor background
# (SignEditScreenMixin / HangingSignEditScreenMixin: textures/gui/{signs,hanging_signs}/canvas[_<dye>].png).
# `sign_text_color` white for the default canvasSignDarkBackgroundList (gray, purple, blue, brown, green, red, black;
# SignBlockEntityMixin), on both forms of a board. Wall forms drop through the engine's wall-variant loot fallback
# (`_wall_` → `_`, `wall_` prefix dropped). Items: FD registers basicItem() (stack 64) for both item kinds.

[canvas_sign]
source = "J/common/registry/ModBlocks.java:CANVAS_SIGN (StandingCanvasSignBlock, ofFullCopy(SPRUCE_SIGN)); J/common/registry/ModItems.java:CANVAS_SIGN (StandingAndWallBlockItem, basicItem)"
# See the M7-06 note above.
template = "minecraft:spruce_sign"
wood_type = "farmersdelight:canvas"
wall_block = "farmersdelight:canvas_wall_sign"
[canvas_sign.components]
"minecraft:max_stack_size" = 64

[canvas_wall_sign]
source = "J/common/registry/ModBlocks.java:CANVAS_WALL_SIGN (WallCanvasSignBlock, loot canvas_sign)"
# See the M7-06 note above.
template = "minecraft:spruce_wall_sign"
wood_type = "farmersdelight:canvas"
item = false

