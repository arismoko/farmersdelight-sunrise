# (Named *.toml.in: the Horizon packager refuses .toml files outside src/.)
# Block declarations (PORT_PLAN M0-06/M1-02). Generated by tools/gen_decls.py.

[cutting_board]
source = "J/common/registry/ModBlocks.java:CUTTING_BOARD (ofFullCopy(OAK_PLANKS).strength(2.0).sound(WOOD)); J/common/block/CuttingBoardBlock.java:SHAPE,FACING,WATERLOGGED; J/common/registry/ModItems.java:CUTTING_BOARD (fuel 200)"
# Template minecraft:stonecutter: its own placement faces the block opposite the placer, as
# CuttingBoardBlock does, so the client's placement prediction (which never asks mods) shows the
# right facing at once; it brings `facing`, no block entity, and is not flammable (FD never
# registers the board as flammable). Its menu never opens: use_item_on answers every main-hand use.
template = "minecraft:stonecutter"
properties = { hardness = 2.0, explosion_resistance = 2.0, occludes = false, requires_tool = false, sounds = "minecraft:oak_planks", map_color = 13 }
state_properties = { waterlogged = { type = "boolean" } }
default_state = { facing = "north", waterlogged = "false" }
shapes = { default = [[0.0625, 0.0, 0.0625, 0.9375, 0.0625, 0.9375]] }
[cutting_board.components]
"minecraft:cooking_fuel" = { burn_time = 200, speed_multiplier = 1.0 }
