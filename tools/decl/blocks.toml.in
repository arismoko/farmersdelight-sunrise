[wild_rice]
source = "J/common/registry/ModBlocks.java:WILD_RICE (ofFullCopy(TALL_GRASS)); J/common/block/WildRiceBlock.java:HALF,WATERLOGGED,canSurvive,getFluidState"
# Template minecraft:tall_grass (DoublePlantBlock, its item places both halves) with a declared `waterlogged`
# for the lower half's water. Default dry (FD's default is the waterlogged lower half; placement and worldgen
# name the state). The outline stays tall grass's (FD's is DoublePlantBlock's full cube).
template = "minecraft:tall_grass"
state_properties = { waterlogged = { type = "boolean" } }
default_state = { half = "lower", waterlogged = "false" }

[wild_rice.components]
"minecraft:compostable" = { layers = "minecraft:compostable/medium" }  # CompostableHelper 0.65
