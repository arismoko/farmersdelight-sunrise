shapes = { default = [[0.125, 0.0, 0.125, 0.875, 0.8125, 0.875]] }
collision_shapes = { default = [] }

[wild_onions.components]
"minecraft:compostable" = { layers = "minecraft:compostable/medium" }  # CompostableHelper 0.65

